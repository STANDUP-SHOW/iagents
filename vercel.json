{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "functions": {
    "api/paiement/session.js": {
      "includeFiles": "agents/AG-*.json",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- frontend vercel.json catalogue agents socle api paiement",
  "rewrites": [
    {
      "source": "/agents",
      "destination": "/catalogue"
    }
  ],
  "redirects": [
    {
      "source": "/inside-iagent",
      "destination": "/iagent-inside-iagent",
      "permanent": true
    }
  ]
}
