{
  // Le Worker : mêmes règles que la racine, plus les types du moteur de
  // Cloudflare, engendrés par `wrangler types` (worker-configuration.d.ts,
  // jamais écrit à la main ni versionné).
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "skipLibCheck": true, "esModuleInterop": true, "types": ["node"], "lib": ["ES2022"]
  },
  "files": ["worker.ts", "worker-configuration.d.ts"]
}
