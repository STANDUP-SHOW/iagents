# Deux minutes après le démarrage, puis toutes les quatre heures : la même
# cadence que mise_a_jour.rs sur les postes Windows. Le délai aléatoire étale
# cinq cents Box sur dix minutes plutôt qu'à la même seconde.
[Unit]
Description=iAgent Box - cadence des mises a jour

[Timer]
OnBootSec=2min
OnUnitActiveSec=4h
RandomizedDelaySec=10min
Persistent=true
Unit=iagent-updater.service

[Install]
WantedBy=timers.target
