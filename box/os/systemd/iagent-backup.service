# Service prévu par le brief (§16) mais NON livré dans iAgent OS 0.1.0 : l'unité
# existe pour que son nom soit réservé et documenté, et son ExecStart refuse en
# français (sortie 78). Pas de [Install] : rien ne l'active au démarrage, et
# check-profils.ts refuse qu'un profil l'allume. Le pourquoi est dans SERVICES.json.
[Unit]
Description=iAgent Box - sauvegarde (non livre dans cette version)

[Service]
Type=oneshot
ExecStart=/usr/lib/iagent/iagent-absent %N
SyslogIdentifier=device
