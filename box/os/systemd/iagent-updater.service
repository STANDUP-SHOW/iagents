# Les mises à jour (brief §31-§33) : relever ce que la plateforme vise, vérifier
# empreinte ET signature, poser le paquet .deb, contrôler la santé, revenir au
# paquet précédent sinon. Un passage à la fois, déclenché par iagent-updater.timer.
[Unit]
Description=iAgent Box - mise a jour signee des composants
After=network-online.target iagent-device.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/iagent-updater appliquer
SyslogIdentifier=update
StateDirectory=iagent
Environment=IAGENT_ETAT=/var/lib/iagent
