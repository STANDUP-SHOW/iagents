{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iagent.agency/schemas/profil-os.json",
  "title": "Profil d'iAgent OS (brief Factory Installer §3) : un par gamme",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "libelle", "description", "materiel", "agents_max", "espaces_navigateur", "pont_applications", "voix", "services_actifs", "kiosque", "source", "releve_le"],
  "properties": {
    "id": { "enum": ["home", "pro", "business"] },
    "libelle": { "type": "string", "minLength": 2, "maxLength": 60 },
    "description": { "type": "string", "minLength": 10 },
    "materiel": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" } },
    "agents_max": { "type": "integer", "minimum": 1, "maximum": 64 },
    "espaces_navigateur": { "type": "integer", "minimum": 1, "maximum": 64 },
    "pont_applications": { "enum": ["active", "optionnel", "inactif"] },
    "voix": {
      "type": "object", "additionalProperties": false, "required": ["demarrage_auto", "test_micro_hp_aec"],
      "properties": { "demarrage_auto": { "type": "boolean" }, "test_micro_hp_aec": { "type": "boolean" } }
    },
    "services_actifs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^iagent-[a-z-]+$" } },
    "kiosque": {
      "type": "object", "additionalProperties": false, "required": ["application", "edition"],
      "properties": { "application": { "const": "iagent-desktop" }, "edition": { "const": "box" } }
    },
    "source": { "type": "string", "minLength": 10 },
    "releve_le": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
