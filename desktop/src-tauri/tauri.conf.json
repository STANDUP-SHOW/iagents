{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run dev:web",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "iAgent Desktop",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": false,
        "open": true
      },
      "clipboard": {
        "all": false,
        "readText": true,
        "writeText": true
      },
      "fs": {
        "all": false,
        "readDir": true,
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "removeDir": true,
        "removeFile": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**"]
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "iAgent Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "agency.iagent.desktop",
      "publisher": "STANDUP-SHOW",
      "category": "Productivity",
      "shortDescription": "iAgent Desktop",
      "longDescription": "iAgent Desktop — orchestration locale d'agents IA avec pilotage vocal.",
      "targets": ["msi", "nsis"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "windows": {
        "wix": {
          "language": "fr-FR"
        }
      }
    }
  }
}
