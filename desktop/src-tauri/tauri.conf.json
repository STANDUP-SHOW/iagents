{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iAgent Desktop",
  "version": "0.1.0",
  "identifier": "com.iagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iAgent Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../agents": "agents",
      "../../catalogue/logiciels.json": "catalogue/logiciels.json",
      "../../catalogue/activites.json": "catalogue/activites.json",
      "../../catalogue/catalogue.json": "catalogue/catalogue.json",
      "../../connecteurs/catalogue.json": "connecteurs/catalogue.json",
      "../../connecteurs/serveurs-mcp.json": "connecteurs/serveurs-mcp.json",
      "../src/config/installation.json": "config/installation.json",
      "../../dimensionnement/paliers-modeles.json": "dimensionnement/paliers-modeles.json",
      "../../dimensionnement/machines.json": "dimensionnement/machines.json",
      "sources-ressources.json": "sources-ressources.json"
    }
  }
}
