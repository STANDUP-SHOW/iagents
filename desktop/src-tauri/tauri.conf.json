{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "iAgent Desktop",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": false,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**", "$DOCUMENT/**"],
        "readDir": true,
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "removeDir": true,
        "removeFile": true
      }
    },
    "windows": [
      {
        "title": "iAgent Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "agency.iagent.desktop",
      "targets": ["msi", "nsis"],
      "publisher": "STANDUP-SHOW",
      "shortDescription": "Orchestration multi-agents locale avec controle vocal",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:11434 http://localhost:11434; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  }
}
