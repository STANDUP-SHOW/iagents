{
  "name": "iagent-back-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iAgent Back-office (MASTER §15) : application desktop interne, ne parle qu'aux routes admin et public de la plateforme.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "banc": "vite build --ssr banc/rendu.jsx --outDir banc/dist --logLevel error && node banc/dist/rendu.js",
    "banc-rust": "cargo test --manifest-path admin/Cargo.toml",
    "plateforme-de-banc": "node --experimental-strip-types banc/plateforme-de-banc.ts",
    "captures": "node banc/captures.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@tauri-apps/api": "^2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.8"
  }
}
